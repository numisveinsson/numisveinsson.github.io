---
layout: default
---
{% assign home = site.data.home %}
<div class="home">
  <section class="hero">
    <div class="hero__intro">
      <p class="hero__role">{{ home.role }}</p>
      <h1>{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="hero__mission">{{ home.mission }}</p>
      <div class="cta-row">
        <a class="cta cta--primary" href="{{ '/research/' | relative_url }}">Explore my research</a>
        <a class="cta" href="{{ '/cv/' | relative_url }}">View CV</a>
        <a class="cta" href="{{ '/contact/' | relative_url }}">Get in touch</a>
      </div>
    </div>
    <figure class="hero__model">
      <div class="model-frame" id="heart-model-frame" style="background-image: url('{{ home.model.poster | relative_url }}')">
        <model-viewer
          id="heart-model"
          data-src="{{ home.model.src | relative_url }}"
          alt="{{ home.model.alt }}"
          camera-controls
          disable-zoom
          interaction-prompt="auto"
          camera-orbit="0deg 80deg auto"
          exposure="1.05"
          tone-mapping="neutral"
        ></model-viewer>
        <button class="model-toggle" id="ct-toggle" type="button" role="switch" aria-checked="false" disabled>Show CT scan</button>
      </div>
      <figcaption>
        <ul class="model-legend">
          {% for item in home.model.legend %}
            <li><span style="background: {{ item.color }}"></span>{{ item.name }}</li>
          {% endfor %}
        </ul>
        <p class="model-hint">{{ home.model.text }}</p>
      </figcaption>
    </figure>
  </section>

  <section class="hero-about">
    <div class="hero__bio">
      {{ content }}
    </div>
    <aside class="hero__aside">
      <div class="hero__photo">
        <img
          src="{{ home.portrait | relative_url }}"
          alt="Portrait of {{ site.first_name }} {{ site.last_name }}"
          loading="lazy"
        >
      </div>
      <ul class="profile-links">
        <li><a href="mailto:{{ site.data.socials.email | encode_email }}">Email</a></li>
        <li><a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a></li>
        <li><a href="https://orcid.org/{{ site.data.socials.orcid_id }}">ORCID</a></li>
        <li><a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn</a></li>
      </ul>
    </aside>
  </section>

  <section class="profile-facts">
    <div>
      <h2>Research interests</h2>
      <p>{{ home.interests }}</p>
    </div>
    <div>
      <h2>Education</h2>
      {% for item in home.education %}
        <p>{{ item.degree }} <span>· {{ item.place }}</span></p>
      {% endfor %}
    </div>
  </section>

  <section class="home-section" id="research">
    <div class="section-title">
      <h2>Research</h2>
      <a href="{{ '/research/' | relative_url }}">Full research overview &rarr;</a>
    </div>
    <div class="theme-grid">
      {% for theme in home.themes %}
        <article class="theme-card">
          <div class="plate">
            <img src="{{ theme.image | relative_url }}" alt="{{ theme.alt }}" loading="lazy">
          </div>
          <h3>{{ theme.title }}</h3>
          <p>{{ theme.text }}</p>
          <a href="{{ theme.link | relative_url }}">{{ theme.link_text }} &rarr;</a>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="home-section">
    <div class="section-title">
      <h2>Selected work</h2>
      <a href="{{ '/publications/' | relative_url }}">All publications &rarr;</a>
    </div>
    <div class="work-list">
      {% for item in home.work %}
        <article class="work-item">
          <div class="plate">
            <img src="{{ item.image | relative_url }}" alt="{{ item.alt }}" loading="lazy">
          </div>
          <div>
            <p class="work-item__meta">{{ item.meta }}</p>
            <h3>{{ item.title }}</h3>
            <p>{{ item.text }}</p>
            <div class="work-item__links">
              {% for link in item.links %}
                <a href="{{ link.url | relative_url }}">{{ link.label }}</a>
              {% endfor %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="home-section">
    <div class="section-title">
      <h2>Open tools</h2>
      <a href="{{ '/software/' | relative_url }}">All software &rarr;</a>
    </div>
    <ul class="tool-list">
      {% for tool in home.tools %}
        <li><a href="{{ tool.url }}">{{ tool.name }}</a></li>
      {% endfor %}
    </ul>
  </section>

  <section class="home-section">
    <div class="section-title">
      <h2>Speaking</h2>
      <a href="{{ '/talks/' | relative_url }}">All talks &rarr;</a>
    </div>
    <div class="work-list">
      {% for talk in home.speaking %}
        <article class="work-item work-item--text">
          <div>
            <p class="work-item__meta">{{ talk.meta }}</p>
            <h3><a href="{{ talk.url | relative_url }}">{{ talk.title }}</a></h3>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="home-section update-grid">
    <div>
      <div class="section-title">
        <h2>News</h2>
        <a href="{{ '/news/' | relative_url }}">All news &rarr;</a>
      </div>
      <ul class="update-list">
        {% assign news = site.news | reverse %}
        {% for item in news limit: 4 %}
          <li>
            <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %-d, %Y' }}</time>
            {% if item.inline %}
              {{ item.content | strip_html | truncatewords: 22 }}
            {% else %}
              <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
    <div>
      <div class="section-title">
        <h2>Latest writing</h2>
        <a href="{{ '/blog/' | relative_url }}">All writing &rarr;</a>
      </div>
      <ul class="update-list">
        {% for post in site.posts limit: 4 %}
          <li>
            <time datetime="{{ post.date | date: '%Y-%m-%d' }}">{{ post.date | date: '%b %-d, %Y' }}</time>
            <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <section class="home-section connect-band">
    <h2>Let's connect</h2>
    <p>
      I'm glad to hear from researchers, clinicians and students working on computational medicine, whether about a collaboration, a talk, or a
      question about the tools.
    </p>
    <a class="cta cta--primary" href="{{ '/contact/' | relative_url }}">Get in touch</a>
  </section>
</div>

<script>
  // Load the 3D viewer only when a visitor gets near it, so the page stays light.
  (function () {
    var viewer = document.getElementById("heart-model");
    var frame = document.getElementById("heart-model-frame");
    var toggle = document.getElementById("ct-toggle");
    viewer.addEventListener("load", function () {
      frame.style.backgroundImage = "none";
      var slices = viewer.model.materials.filter(function (material) {
        return material.name.indexOf("CT") === 0;
      });
      toggle.disabled = false;
      toggle.addEventListener("click", function () {
        var on = toggle.getAttribute("aria-checked") !== "true";
        slices.forEach(function (material) {
          material.pbrMetallicRoughness.setBaseColorFactor([1, 1, 1, on ? 1 : 0]);
        });
        toggle.setAttribute("aria-checked", on ? "true" : "false");
        toggle.textContent = on ? "Hide CT scan" : "Show CT scan";
        frame.classList.toggle("is-ct", on);
        viewer.cameraOrbit = on ? "30deg 68deg auto" : "0deg 80deg auto";
      });
    });
    function load() {
      var script = document.createElement("script");
      script.type = "module";
      script.src = "https://cdn.jsdelivr.net/npm/@google/model-viewer@4.3.1/dist/model-viewer.min.js";
      script.integrity = "sha384-cprcVQt7wbUl0xngF3PGP6yBB7n4/t+4AoAMG9biiMCGFiWOdzUH10Ie2COTqFNW";
      script.crossOrigin = "anonymous";
      document.head.appendChild(script);
      viewer.setAttribute("src", viewer.dataset.src);
    }
    function start() {
      if (!("IntersectionObserver" in window)) {
        load();
        return;
      }
      var observer = new IntersectionObserver(
        function (entries) {
          if (entries[0].isIntersecting) {
            observer.disconnect();
            load();
          }
        },
        { rootMargin: "400px" }
      );
      observer.observe(viewer);
    }
    if (document.readyState === "complete") {
      start();
    } else {
      window.addEventListener("load", start);
    }
  })();
</script>
