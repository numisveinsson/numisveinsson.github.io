<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <p class="site-footer__name">{{ site.first_name }} {{ site.last_name }}</p>
        <p>
          Center for Computational Medicine<br>
          Oden Institute, UT Austin
        </p>
      </div>
      <nav aria-label="Footer">
        <p class="site-footer__heading">Explore</p>
        <ul>
          <li><a href="{{ '/research/' | relative_url }}">Research</a></li>
          <li><a href="{{ '/publications/' | relative_url }}">Publications</a></li>
          <li><a href="{{ '/software/' | relative_url }}">Software</a></li>
          <li><a href="{{ '/blog/' | relative_url }}">Writing</a></li>
          <li><a href="{{ '/cv/' | relative_url }}">CV</a></li>
          <li><a href="{{ '/news/' | relative_url }}">News</a></li>
        </ul>
      </nav>
      <div>
        <p class="site-footer__heading">Connect</p>
        <ul>
          <li><a href="{{ '/contact/' | relative_url }}">Get in touch</a></li>
          <li><a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn</a></li>
          <li><a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a></li>
          <li><a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a></li>
          <li><a href="{{ '/feed.xml' | relative_url }}">RSS feed</a></li>
        </ul>
      </div>
    </div>
    <p class="site-footer__legal">&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</p>
  </div>
</footer>
